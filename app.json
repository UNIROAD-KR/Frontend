{
  "expo": {
    "name": "univ",
    "slug": "univ",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "univ",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uniroad.mobile",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.uniroad.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-ios-modular-headers",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "74ee7bda6641cc4cc638a8458c0e249d",
          "kotlinVersion": "2.0.21"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.803840308244-onouauek1qv66kqirf9hjmqlb96dck2n"
        }
      ],
      [
        "@react-native-seoul/naver-login",
        {
          "consumerKey": "3jo54WreHzQliJbUhzPo",
          "consumerSecret": "_N6TMAqNu0",
          "serviceUrlSchemeIOS": "naverlogin"
        }
      ],
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/uniroad-splash-logo.png",
          "imageWidth": 185,
          "resizeMode": "contain",
          "backgroundColor": "#F6F7F9",
          "dark": {
            "backgroundColor": "#F6F7F9"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6739804f-a683-4b82-8320-80c64afa4d30"
      }
    }
  }
}
